# https://developer.tech.yandex.ru/
# На одном ключе должны быть включены:
#   • JavaScript API — карта на шаге «Где встретимся?»
#   • API Геосаджеста — подсказки в поиске
#   • API Геокодера — координаты выбранного места
# Static API в этом проекте не используется.
# Referer: http://localhost:5173 (и ваш домен для продакшена)
VITE_YANDEX_MAPS_API_KEY=

# Рекламные подборки образов на шаге «Образ и подготовка»
VITE_LOOK_ADS_ENABLED=false
